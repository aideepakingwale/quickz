# bootstrap.sh writes the real .env for you. Never commit it.
DOMAIN=myquiz.duckdns.org
QUICKZ_SETUP_TOKEN=change-me-to-a-long-random-string
QUICKZ_MAX_MEDIA_MB=50
# Only when the public IP changes at every start (no Elastic IP): keeps the DuckDNS name pointing at this server.
DUCKDNS_NAME=
DUCKDNS_TOKEN=
# Optional: an S3 bucket for off-server backups (the instance role needs write access to it).
BACKUP_BUCKET=
# Pictures in S3 + CloudFront (the CloudFormation template sets these): the server's IAM role does the uploading.
QUICKZ_S3_ENDPOINT=
QUICKZ_S3_BUCKET=
QUICKZ_S3_USE_ROLE=
QUICKZ_PUBLIC_BUCKET_URL=
